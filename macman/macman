#!/usr/bin/env python

import subprocess
import sys
from typing import Any
from typing import Callable
from typing import Literal


Group = Literal["general", "multiplexer", "git"]

_REGISTERD_COMMANDS: dict[str, Any] = {}
_REGISTERED_GROUP: set[Group] = set()


def register_command(
    command: str, command_group: Group, description: str
) -> Callable[[Callable], Callable]:
    def decorator(func: Callable) -> Callable:
        _REGISTERD_COMMANDS[command] = {
            "description": description,
            "group": command_group,
            "command": func,
        }
        _REGISTERED_GROUP.add(command_group)
        return func

    return decorator


# General functions
@register_command("info", "general", "Get OS info")
def system_info(args: None) -> str:
    return "sw_vers"


@register_command("lock", "general", "Lock screen")
def lock_screen(args: None) -> str:
    return """osascript -e 'tell application "System Events" to keystroke "q" using {control down, command down}'"""


@register_command("ports", "general", "Get list of used ports")
def ports(args: None) -> str:
    return "sudo lsof -iTCP -sTCP:LISTEN -P"


@register_command("uptime", "general", "Get uptime")
def get_uptime(args: None) -> str:
    return "uptime"


@register_command("weather", "general", "Get weather")
def get_weather_info(args: list[str] | None) -> str:
    return "curl wttr.in"


# TMUX related
@register_command("t.div.h", "multiplexer", "Split tmux pane horizontally")
def tmux_split_horizontal(args: None) -> str:
    return "tmux split-window -h"


@register_command("t.div.v", "multiplexer", "Split tmux pane vertically")
def tmux_split_vertical(args: None) -> str:
    return "tmux split-window -v"


def run_command(command: str, args: list[str] | None) -> None:
    final_command = _REGISTERD_COMMANDS[command]["command"](args)
    if isinstance(final_command, str):
        final_command = final_command.split(" ")

    results = subprocess.run(final_command, capture_output=True)

    stdout = results.stdout.decode("utf-8")
    if stdout:
        print(stdout)


def get_commands(group: Group | None = None) -> dict[str, str]:
    if group:
        return {
            command: data["description"]
            for command, data in _REGISTERD_COMMANDS.items()
            if data["group"] == group
        }
    return {
        command: data["description"] for command, data in _REGISTERD_COMMANDS.items()
    }


def print_help(command: str | Group | None = None) -> None:
    print("Available commands:")
    if command in _REGISTERED_GROUP:
        print("-" * 20)
        print(f"{command.capitalize()}")
        print("-" * 20)
        for command, description in get_commands(command).items():  # type: ignore
            print(f"{command}: {description}")
        print("-" * 20)
    elif command:
        print(f"{command}: {_REGISTERD_COMMANDS[command]['description']}")
    else:
        for group in sorted(_REGISTERED_GROUP):
            print("-" * 20)
            print(f"{group.capitalize()}")
            print("-" * 20)
            for command, description in get_commands(group).items():
                print(f"{command}: {description}")
            print("-" * 20)


def process_args() -> tuple[str, list[str]]:
    if len(sys.argv) == 1:
        # No argument supplied, print help
        return "help", []
    elif len(sys.argv) == 2:
        return sys.argv[1], []
    else:
        return sys.argv[1], sys.argv[2:]


def main():
    command, command_args = process_args()

    if command == "help":
        if len(command_args) == 0:
            print_help()
        else:
            print_help(command_args[0])
    elif command in _REGISTERED_GROUP:
        print_help(command)
    elif command in _REGISTERD_COMMANDS:
        run_command(command, command_args)
    else:
        print(f"Command {command} not found")


if __name__ == "__main__":
    main()
