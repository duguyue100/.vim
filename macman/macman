#!/usr/bin/env python

import shutil
import subprocess
import sys
from typing import Any
from typing import Callable
from typing import Literal


Group = Literal["general", "multiplexer", "git", "functions"]

_REGISTERD_COMMANDS: dict[str, Any] = {}
_REGISTERED_GROUP: set[Group] = set()


def register_command(
    command: str, command_group: Group, description: str
) -> Callable[[Callable], Callable]:
    def decorator(func: Callable) -> Callable:
        _REGISTERD_COMMANDS[command] = {
            "description": description,
            "group": command_group,
            "command": func,
        }
        _REGISTERED_GROUP.add(command_group)
        return func

    return decorator


# General functions
@register_command("info", "general", "Get OS info")
def system_info(args: None) -> str:
    return "sw_vers"


@register_command("lock", "general", "Lock screen")
def lock_screen(args: None) -> str:
    return """osascript -e 'tell application "System Events" to keystroke "q" using {control down, command down}'"""


@register_command("ports", "general", "Get list of used ports")
def ports(args: None) -> str:
    return "sudo lsof -iTCP -sTCP:LISTEN -P"


@register_command("uptime", "general", "Get uptime")
def get_uptime(args: None) -> str:
    return "uptime"


@register_command("weather", "general", "Get weather")
def get_weather_info(args: list[str] | None) -> str:
    return "curl wttr.in"


@register_command("waka", "general", "Open wakatime dashboard")
def open_waka(args: list[str] | None) -> str:
    return "open https://wakatime.com/dashboard"


@register_command("fd.size", "general", "Get folder size")
def folder_size(args: list[str]) -> str:
    return f"du -sch {' '.join(args)}"


@register_command("disk", "general", "Print disk usage")
def disk_usage(args: None) -> str:
    if shutil.which("duf"):
        return "duf"
    return "df -h"


@register_command("jpy2html", "functions", "Render jupyter notebook as html")
def render_jupyter_notebook(args: list[str]) -> str:
    file = args[0]
    outfile = file.replace(".ipynb", ".html")
    print(f"The rendered file is saved as {outfile}.")
    return f"jupyter nbconvert --to html {file}"


